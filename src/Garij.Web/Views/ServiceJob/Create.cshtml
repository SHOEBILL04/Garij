@model Garij.Application.DTOs.ServiceJobDto
@using Garij.Domain.Enums

@{
    ViewData["Title"] = "Create Service Job";
}

<div class="app-page-header">
    <div>
        <h1 class="app-page-title">Create New Service Job</h1>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="app-card">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="app-alert-danger" role="alert"></div>

                <div class="app-form-group">
                    <label asp-for="VehicleId" class="app-form-label">Select Vehicle &amp; Customer</label>
                    <select asp-for="VehicleId" asp-items="ViewBag.Vehicles" class="app-form-select" id="vehicleSelect">
                        <option value="">-- Choose Vehicle --</option>
                    </select>
                    <span asp-validation-for="VehicleId" class="app-field-error"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 app-form-group">
                        <label asp-for="JobType" class="app-form-label">Job Type</label>
                        <select asp-for="JobType" asp-items="Html.GetEnumSelectList<JobType>()" class="app-form-select"></select>
                        <span asp-validation-for="JobType" class="app-field-error"></span>
                    </div>
                    <div class="col-md-6 app-form-group">
                        <label asp-for="Status" class="app-form-label">Initial Status</label>
                        <select asp-for="Status" asp-items="Html.GetEnumSelectList<JobStatus>()" class="app-form-select"></select>
                        <span asp-validation-for="Status" class="app-field-error"></span>
                    </div>
                </div>

                <div class="app-form-group">
                    <label asp-for="BookingReference" class="app-form-label">Booking Reference (Optional)</label>
                    <input asp-for="BookingReference" class="app-form-control" placeholder="Leave empty for auto-generated (e.g. GRJ-2026-0001)" />
                    <div class="app-page-subtitle small mt-1">System will generate a unique reference if left blank.</div>
                    <span asp-validation-for="BookingReference" class="app-field-error"></span>
                </div>

                @await Html.PartialAsync("_IntakeAssistantPartial")

                <div class="app-form-group">
                    <label asp-for="DiagnosticNotes" class="app-form-label">Diagnostic / Customer Notes</label>

                    <textarea asp-for="DiagnosticNotes" class="app-form-control" rows="4" placeholder="Describe customer requests or initial diagnostic observations..."></textarea>
                    <span asp-validation-for="DiagnosticNotes" class="app-field-error"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <a asp-action="Index" class="app-btn app-btn-outline">Cancel</a>
                    <button type="submit" class="app-btn app-btn-primary"><i class="bi bi-check-circle"></i> Create Job</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
