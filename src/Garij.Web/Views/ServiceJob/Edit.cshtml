@model Garij.Application.DTOs.ServiceJobDto
@using Garij.Domain.Enums

@{
    ViewData["Title"] = $"Edit Service Job - {Model.BookingReference}";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-secondary text-white py-3">
                    <h2 class="h5 card-title mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Service Job (@Model.BookingReference)</h2>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="VehicleId" />
                        <input type="hidden" asp-for="BookingReference" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label class="form-label text-muted">Vehicle</label>
                            <input class="form-control" value="@Model.VehiclePlateNumber - @Model.VehicleDescription" readonly />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="JobType" class="form-label fw-bold">Job Type</label>
                                <select asp-for="JobType" asp-items="Html.GetEnumSelectList<JobType>()" class="form-select"></select>
                                <span asp-validation-for="JobType" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Status" class="form-label fw-bold">Current Status</label>
                                <select asp-for="Status" asp-items="Html.GetEnumSelectList<JobStatus>()" class="form-select"></select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="DiagnosticNotes" class="form-label fw-bold">Diagnostic Notes</label>
                            <textarea asp-for="DiagnosticNotes" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="DiagnosticNotes" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
