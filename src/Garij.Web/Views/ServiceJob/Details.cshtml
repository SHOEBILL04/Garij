@model Garij.Application.DTOs.ServiceJobDto
@using Garij.Domain.Enums
@using Garij.Web.Helpers

@{
    ViewData["Title"] = $"Job Details - {Model.BookingReference}";
}

<div class="app-page-header">
    <div>
        <h1 class="app-page-title mb-2">
            Booking Reference: <span class="font-monospace text-info">@Model.BookingReference</span>
        </h1>
        <span class="app-badge @StatusBadgeHelper.BadgeClass(Model.Status)">@Model.Status</span>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-controller="Parts" asp-action="LogUsage" asp-route-serviceJobId="@Model.Id" class="app-btn app-btn-primary">
            <i class="bi bi-box-seam"></i> Log Parts
        </a>
        <a asp-action="LogService" asp-route-serviceJobId="@Model.Id" class="app-btn app-btn-primary">
            <i class="bi bi-wrench-adjustable"></i> Log Service
        </a>
        <a asp-controller="Mechanic" asp-action="Assign" asp-route-serviceJobId="@Model.Id" class="app-btn app-btn-success">
            <i class="bi bi-person-plus"></i> Assign Mechanic
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="app-btn app-btn-outline">
            <i class="bi bi-pencil"></i> Edit Job
        </a>
        <a asp-action="Index" class="app-btn app-btn-outline">Back to List</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="app-alert-success"><span><i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]</span></div>
}

<div class="row g-4">
    <!-- Main Job & Vehicle Info Card -->
    <div class="col-lg-7">
        <div class="app-card mb-4">
            <h5 class="app-card-heading"><i class="bi bi-card-checklist me-2 text-info"></i>Job &amp; Vehicle Information</h5>
            <dl class="row mb-0">
                <dt class="col-sm-4 app-page-subtitle">Vehicle License Plate:</dt>
                <dd class="col-sm-8 fw-bold text-white">@Model.VehiclePlateNumber</dd>

                <dt class="col-sm-4 app-page-subtitle">Vehicle Details:</dt>
                <dd class="col-sm-8 text-white">@Model.VehicleDescription</dd>

                <dt class="col-sm-4 app-page-subtitle">Customer Name:</dt>
                <dd class="col-sm-8 fw-semibold text-white">@Model.CustomerName</dd>

                <dt class="col-sm-4 app-page-subtitle">Job Type:</dt>
                <dd class="col-sm-8"><span class="app-badge app-badge-neutral">@Model.JobType</span></dd>

                <dt class="col-sm-4 app-page-subtitle">Date Created:</dt>
                <dd class="col-sm-8 text-white">@Model.CreatedAt.ToString("f")</dd>

                @if (Model.CompletedAt.HasValue)
                {
                    <dt class="col-sm-4 app-page-subtitle">Date Completed:</dt>
                    <dd class="col-sm-8 fw-bold" style="color:#4ade80;">@Model.CompletedAt.Value.ToString("f")</dd>
                }

                <dt class="col-sm-4 app-page-subtitle">Diagnostic Notes:</dt>
                <dd class="col-sm-8 text-white text-break mb-0">
                    @(string.IsNullOrWhiteSpace(Model.DiagnosticNotes) ? "No notes recorded yet." : Model.DiagnosticNotes)
                </dd>
            </dl>
        </div>
    </div>

    <!-- Assigned Mechanics Card -->
    <div class="col-lg-5">
        <div class="app-card mb-4">
            <div class="d-flex justify-content-between align-items-center app-card-heading">
                <span><i class="bi bi-people me-2 text-info"></i>Assigned Mechanics</span>
                <a asp-controller="Mechanic" asp-action="Assign" asp-route-serviceJobId="@Model.Id" class="app-btn app-btn-success app-btn-sm">+ Assign</a>
            </div>
            @if (!Model.MechanicAssignments.Any())
            {
                <p class="app-page-subtitle text-center py-2 mb-0">No mechanics assigned to this job yet.</p>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var assignment in Model.MechanicAssignments)
                    {
                        <div class="d-flex justify-content-between align-items-center pb-3" style="border-bottom: 1px solid var(--border-dark);">
                            <div>
                                <div class="fw-bold text-white">@assignment.MechanicName</div>
                                <span class="app-badge @(assignment.RoleInJob == RoleInJob.Lead ? "app-badge-info" : "app-badge-neutral")">
                                    @assignment.RoleInJob
                                </span>
                                <div class="small app-page-subtitle mt-1">Assigned: @assignment.AssignedAt.ToString("MMM dd, yyyy")</div>
                            </div>
                            <div class="d-flex gap-2">
                                <a asp-controller="Mechanic" asp-action="EditAssignment" asp-route-id="@assignment.Id" asp-route-serviceJobId="@Model.Id" class="app-btn app-btn-outline app-btn-sm">
                                    <i class="bi bi-pencil"></i> Edit Role
                                </a>
                                <form asp-controller="Mechanic" asp-action="RemoveAssignment" method="post" onsubmit="return confirm('Remove mechanic assignment?');">
                                    <input type="hidden" name="id" value="@assignment.Id" />
                                    <input type="hidden" name="serviceJobId" value="@Model.Id" />
                                    <button type="submit" class="app-btn app-btn-danger app-btn-sm">
                                        <i class="bi bi-trash"></i> Remove
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Services & Labour Card -->
    <div class="col-12">
        <div class="app-card mb-4">
            <div class="d-flex justify-content-between align-items-center app-card-heading">
                <span><i class="bi bi-wrench-adjustable me-2 text-info"></i>Services &amp; Labour</span>
                <a asp-action="LogService" asp-route-serviceJobId="@Model.Id" class="app-btn app-btn-primary app-btn-sm">+ Log Service</a>
            </div>
            @if (!Model.JobServiceDetails.Any())
            {
                <p class="app-page-subtitle text-center py-2 mb-0">No services logged against this job yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table app-table mb-0">
                        <thead>
                            <tr>
                                <th>Service</th>
                                <th class="text-end">Qty</th>
                                <th class="text-end">Price at Booking</th>
                                <th class="text-end">Line Total</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in Model.JobServiceDetails)
                            {
                                <tr>
                                    <td class="text-white">@line.ServiceName</td>
                                    <td class="text-end text-white">@line.Quantity</td>
                                    <td class="text-end text-white">@line.PriceAtBooking.ToString("C")</td>
                                    <td class="text-end fw-bold text-white">@((line.PriceAtBooking * line.Quantity).ToString("C"))</td>
                                    <td class="text-end">
                                        <form asp-action="RemoveService" method="post" onsubmit="return confirm('Remove this service from the job?');">
                                            <input type="hidden" name="id" value="@line.Id" />
                                            <input type="hidden" name="serviceJobId" value="@Model.Id" />
                                            <button type="submit" class="app-btn app-btn-danger app-btn-sm">
                                                <i class="bi bi-trash"></i> Remove
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
