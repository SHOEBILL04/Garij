@model IEnumerable<Garij.Application.DTOs.ServiceJobDto>
@using Garij.Domain.Enums

@{
    ViewData["Title"] = "Service Jobs";
    var selectedStatus = ViewBag.SelectedStatus as JobStatus?;
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Service Jobs</h1>
            <p class="text-muted small mb-0">Manage vehicle service jobs, track status progression, and assign mechanics.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Create Service Job
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Status Filter Pills -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body py-2">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="fw-semibold text-muted me-2"><i class="bi bi-funnel me-1"></i> Filter by Status:</span>
                <a asp-action="Index" class="btn btn-sm @(!selectedStatus.HasValue ? "btn-dark" : "btn-outline-secondary")">
                    All Jobs
                </a>
                @foreach (JobStatus status in Enum.GetValues(typeof(JobStatus)))
                {
                    var isSelected = selectedStatus.HasValue && selectedStatus.Value == status;
                    var badgeClass = status switch
                    {
                        JobStatus.Requested => "btn-outline-warning text-dark",
                        JobStatus.InspectionPending => "btn-outline-info",
                        JobStatus.CustomerApprovalNeeded => "btn-outline-primary",
                        JobStatus.InProgress => "btn-outline-primary",
                        JobStatus.Completed => "btn-outline-success",
                        JobStatus.Cancelled => "btn-outline-danger",
                        _ => "btn-outline-secondary"
                    };
                    if (isSelected)
                    {
                        badgeClass = status switch
                        {
                            JobStatus.Requested => "btn-warning text-dark",
                            JobStatus.InspectionPending => "btn-info text-white",
                            JobStatus.CustomerApprovalNeeded => "btn-primary",
                            JobStatus.InProgress => "btn-primary",
                            JobStatus.Completed => "btn-success",
                            JobStatus.Cancelled => "btn-danger",
                            _ => "btn-secondary"
                        };
                    }

                    <a asp-action="Index" asp-route-status="@status" class="btn btn-sm @badgeClass">
                        @status
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Jobs Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Booking Ref</th>
                            <th>Vehicle & Customer</th>
                            <th>Job Type</th>
                            <th>Status</th>
                            <th>Assigned Mechanics</th>
                            <th>Created Date</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                    No service jobs found @(selectedStatus.HasValue ? $"with status '{selectedStatus.Value}'" : "").
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var job in Model)
                            {
                                var statusBadge = job.Status switch
                                {
                                    JobStatus.Requested => "bg-warning text-dark",
                                    JobStatus.InspectionPending => "bg-info text-dark",
                                    JobStatus.CustomerApprovalNeeded => "bg-secondary",
                                    JobStatus.InProgress => "bg-primary",
                                    JobStatus.Completed => "bg-success",
                                    JobStatus.Cancelled => "bg-danger",
                                    _ => "bg-secondary"
                                };

                                <tr>
                                    <td class="ps-4 fw-bold">
                                        <a asp-action="Details" asp-route-id="@job.Id" class="text-decoration-none font-monospace">
                                            @job.BookingReference
                                        </a>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@job.VehiclePlateNumber</div>
                                        <div class="small text-muted">@job.VehicleDescription</div>
                                        <div class="small text-secondary"><i class="bi bi-person me-1"></i>@job.CustomerName</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@job.JobType</span>
                                    </td>
                                    <td>
                                        <span class="badge @statusBadge rounded-pill px-3 py-2">@job.Status</span>
                                    </td>
                                    <td>
                                        @if (job.MechanicAssignments.Any())
                                        {
                                            @foreach (var m in job.MechanicAssignments)
                                            {
                                                <span class="badge bg-outline-dark text-dark border me-1 mb-1">
                                                    <i class="bi bi-tools me-1"></i>@m.MechanicName (@m.RoleInJob)
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small italic">Unassigned</span>
                                        }
                                    </td>
                                    <td class="small text-muted">
                                        @job.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-outline-primary" title="View Details">
                                                View
                                            </a>
                                            <a asp-controller="Mechanic" asp-action="Assign" asp-route-serviceJobId="@job.Id" class="btn btn-outline-success" title="Assign Mechanic">
                                                Assign
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@job.Id" class="btn btn-outline-secondary" title="Edit Job">
                                                Edit
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
