@model Garij.Application.DTOs.JobServiceDetailDto
@using Garij.Application.DTOs

@{
    ViewData["Title"] = "Log Service";
    var job = ViewBag.ServiceJob as ServiceJobDto;
}

<div class="app-page-header">
    <div>
        <h1 class="app-page-title">Log Service (Labour)</h1>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="app-card">
            @if (job != null)
            {
                <div class="app-card mb-4" style="background: rgba(255,255,255,0.04);">
                    <div class="fw-bold text-info mb-1">Booking Reference: @job.BookingReference</div>
                    <div class="small text-white"><strong>Vehicle:</strong> @job.VehiclePlateNumber (@job.VehicleDescription)</div>
                    <div class="small text-white"><strong>Customer:</strong> @job.CustomerName</div>
                </div>
            }

            <form asp-action="LogService" method="post">
                <input type="hidden" asp-for="ServiceJobId" />
                <div asp-validation-summary="ModelOnly" class="app-alert-danger" role="alert"></div>

                <div class="app-form-group">
                    <label asp-for="ServiceCatalogId" class="app-form-label">Catalogue Service</label>
                    <select asp-for="ServiceCatalogId" asp-items="ViewBag.ServiceCatalogue" class="app-form-select">
                        <option value="">-- Choose Service --</option>
                    </select>
                    <div class="app-page-subtitle small mt-1">The catalogue price is captured now and will not change if the catalogue is edited later.</div>
                    <span asp-validation-for="ServiceCatalogId" class="app-field-error"></span>
                </div>

                <div class="app-form-group">
                    <label asp-for="Quantity" class="app-form-label">Quantity</label>
                    <input asp-for="Quantity" class="app-form-control" placeholder="e.g. 1" min="1" />
                    <span asp-validation-for="Quantity" class="app-field-error"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <a asp-action="Details" asp-route-id="@Model.ServiceJobId" class="app-btn app-btn-outline">Cancel</a>
                    <button type="submit" class="app-btn app-btn-primary"><i class="bi bi-check-lg"></i> Add Labour</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
