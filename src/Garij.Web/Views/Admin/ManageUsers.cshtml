@model IEnumerable<Garij.Domain.Entities.User>
@using Garij.Domain.Enums
@{
    ViewData["Title"] = "Manage Staff Users";
}

<div class="app-page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h1 class="app-page-title"><i class="bi bi-people-fill me-2 text-info"></i>Manage Staff Accounts</h1>
        <p class="app-page-subtitle">Create and manage accounts for workshop managers, front desk receptionists, and certified mechanics.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="CreateUser" class="app-btn app-btn-primary">
            <i class="bi bi-person-plus-fill me-1"></i> Create Staff Account
        </a>
        <a asp-action="ManageRoles" class="app-btn app-btn-outline">
            <i class="bi bi-person-badge me-1"></i> Manage Roles
        </a>
        <a asp-action="Index" class="app-btn app-btn-outline">Back to Admin</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success bg-opacity-10 bg-success text-success border-success mb-4 p-3 rounded-3">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger bg-opacity-10 bg-danger text-danger border-danger mb-4 p-3 rounded-3">
        <i class="bi bi-x-circle-fill me-2"></i> @TempData["ErrorMessage"]
    </div>
}

<div class="app-card">
    @if (!Model.Any())
    {
        <div class="app-empty-state py-5 text-center">
            <i class="bi bi-people display-4 text-secondary mb-3 d-block"></i>
            <h5 class="text-white">No staff accounts found</h5>
            <p class="text-secondary small mb-3">Get started by creating your first receptionist or mechanic account.</p>
            <a asp-action="CreateUser" class="app-btn app-btn-primary">Create Staff Account</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr class="border-secondary border-opacity-25 text-secondary small text-uppercase">
                        <th>Full Name</th>
                        <th>Email Address</th>
                        <th>Phone Number</th>
                        <th>Assigned Role</th>
                        <th>Date Registered</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-dark border border-secondary border-opacity-50 text-info fw-bold d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                        @(string.IsNullOrWhiteSpace(user.FullName) ? "?" : user.FullName.Substring(0, 1).ToUpper())
                                    </div>
                                    <strong class="text-white">@user.FullName</strong>
                                </div>
                            </td>
                            <td class="font-monospace small text-light">@user.Email</td>
                            <td class="small text-secondary">@(string.IsNullOrWhiteSpace(user.PhoneNumber) ? "—" : user.PhoneNumber)</td>
                            <td>
                                @switch (user.Role)
                                {
                                    case UserRole.Admin:
                                        <span class="badge bg-primary px-2 py-1"><i class="bi bi-shield-lock me-1"></i>Administrator</span>
                                        break;
                                    case UserRole.FrontDesk:
                                        <span class="badge bg-info text-dark px-2 py-1"><i class="bi bi-clipboard-check me-1"></i>Front Desk</span>
                                        break;
                                    case UserRole.Mechanic:
                                        <span class="badge bg-warning text-dark px-2 py-1"><i class="bi bi-wrench me-1"></i>Mechanic</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">@user.Role</span>
                                        break;
                                }
                            </td>
                            <td class="small text-secondary">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
