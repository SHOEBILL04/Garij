@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const btnTestCheckout = document.getElementById('btnTestCheckout');
            const checkoutForm = document.getElementById('checkoutForm');
            const isTestPaymentInput = document.getElementById('isTestPaymentInput');

            if (btnTestCheckout && checkoutForm) {
                btnTestCheckout.addEventListener('click', function () {
                    // Populate dummy details if empty
                    const buyerName = document.getElementById('BuyerName');
                    const buyerEmail = document.getElementById('BuyerEmail');
                    const cardNumber = document.getElementById('CardNumber');
                    const expiryDate = document.getElementById('ExpiryDate');
                    const cvv = document.getElementById('Cvv');
                    const cardholderName = document.getElementById('CardholderName');

                    if (buyerName && !buyerName.value) buyerName.value = "Demo Workshop Owner";
                    if (buyerEmail && !buyerEmail.value) buyerEmail.value = "demo.owner@garij.com";
                    if (cardholderName && !cardholderName.value) cardholderName.value = "Demo Workshop Owner";
                    if (cardNumber && !cardNumber.value) cardNumber.value = "4242 4242 4242 4242";
                    if (expiryDate && !expiryDate.value) expiryDate.value = "12/28";
                    if (cvv && !cvv.value) cvv.value = "999";

                    if (isTestPaymentInput) {
                        isTestPaymentInput.value = "true";
                    }

                    checkoutForm.submit();
                });
            }

            const btnFillDemoKey = document.getElementById('btnFillDemoKey');
            const licenseKeyInput = document.getElementById('licenseKey');
            if (btnFillDemoKey && licenseKeyInput) {
                btnFillDemoKey.addEventListener('click', function () {
                    licenseKeyInput.value = "GRJ-DEMO-2026-KEY";
                    licenseKeyInput.focus();
                });
            }
        });
    </script>
}
