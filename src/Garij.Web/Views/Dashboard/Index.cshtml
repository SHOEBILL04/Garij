@model Garij.Web.Models.FrontDeskDashboardViewModel
@{
    ViewData["Title"] = "Front Desk Dashboard";
}

<!-- Welcome Banner -->
<div class="app-card mb-4" style="background: linear-gradient(135deg, rgba(0,114,245,0.18), rgba(0,210,255,0.08)); border-color: rgba(0,168,255,0.35);">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <div>
            <h1 class="app-page-title mb-1"><i class="bi bi-clipboard-check me-2 text-info"></i>Front Desk Dashboard</h1>
            <p class="app-page-subtitle mb-0">
                Workspace for reception staff: vehicle intake, service-due outreach, live job tracking, invoicing, and customer updates.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="ServiceJob" asp-action="Create" class="app-btn app-btn-primary text-nowrap">
                <i class="bi bi-plus-lg me-1"></i> New Service Job
            </a>
        </div>
    </div>
</div>

<!-- Vehicle Maintenance Predictions & Service-Due Alerts -->
<div class="app-card mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-3 pb-3 border-bottom border-secondary border-opacity-25">
        <div>
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-cpu fs-3 text-info"></i>
                <h3 class="text-white fw-bold mb-0 fs-5">Vehicle Maintenance Predictions &amp; Service-Due Alerts</h3>
            </div>
            <p class="app-page-subtitle mb-0 mt-1">
                Automated predictive maintenance scheduling computed from each vehicle's historical service cadence.
            </p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="app-badge app-badge-danger">
                <i class="bi bi-exclamation-octagon-fill me-1"></i>@Model.OverdueCount Overdue
            </span>
            <span class="app-badge app-badge-warning">
                <i class="bi bi-clock-history me-1"></i>@Model.DueSoonCount Due Soon
            </span>
            <span class="app-badge app-badge-info">
                <i class="bi bi-car-front-fill me-1"></i>@Model.TotalDueCount Due For Service
            </span>
        </div>
    </div>

    @if (!Model.DueVehicles.Any())
    {
        <div class="app-empty-state py-4">
            <i class="bi bi-shield-check text-success fs-1"></i>
            <h5 class="text-white fw-semibold mt-2">All Vehicles Up to Date</h5>
            <p class="app-page-subtitle mb-0">Every vehicle in the registry is within its healthy service interval or currently in progress.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="app-table mb-0">
                <thead>
                    <tr>
                        <th>Vehicle &amp; Customer</th>
                        <th>Cadence &amp; History</th>
                        <th>Predicted Due</th>
                        <th>Recommended Action</th>
                        <th>Urgency</th>
                        <th class="text-end">Quick Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.DueVehicles)
                    {
                        var isOverdue = item.UrgencyLevel == "Overdue";
                        <tr>
                            <td>
                                <div class="fw-bold text-white font-monospace">@item.LicensePlateNumber</div>
                                <div class="small text-white opacity-75">@item.Year @item.Make @item.Model (@item.Color)</div>
                                <div class="small app-page-subtitle mt-0">
                                    <i class="bi bi-person me-1"></i>@item.CustomerName
                                    @if (!string.IsNullOrWhiteSpace(item.CustomerPhoneNumber))
                                    {
                                        <span class="ms-2"><i class="bi bi-telephone me-1"></i><a href="tel:@item.CustomerPhoneNumber" class="text-info text-decoration-none">@item.CustomerPhoneNumber</a></span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (item.LastServiceDate.HasValue)
                                {
                                    <div class="small text-white">
                                        Last serviced: <strong>@item.LastServiceDate.Value.ToString("yyyy-MM-dd")</strong>
                                    </div>
                                    <div class="small app-page-subtitle">
                                        (@item.DaysSinceLastService days ago &bull; @item.TotalServicesCompleted service@(item.TotalServicesCompleted == 1 ? "" : "s"))
                                    </div>
                                    <div class="small text-muted">
                                        Cycle: ~@(item.AverageIntervalDays ?? 90) days
                                    </div>
                                }
                                else
                                {
                                    <div class="small text-warning">
                                        <i class="bi bi-exclamation-circle me-1"></i>No service recorded
                                    </div>
                                    <div class="small app-page-subtitle">Initial intake needed</div>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold text-white">
                                    @item.PredictedDueDate.ToString("yyyy-MM-dd")
                                </div>
                                <div class="small @(isOverdue ? "text-danger fw-semibold" : "text-warning")">
                                    @if (isOverdue)
                                    {
                                        <span><i class="bi bi-arrow-up-circle-fill me-1"></i>@item.DaysOverdue days overdue</span>
                                    }
                                    else
                                    {
                                        <span><i class="bi bi-hourglass-split me-1"></i>Due in @item.EstimatedDaysUntilDue days</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold text-white small">@item.RecommendedService</div>
                                <div class="small app-page-subtitle mt-0">@item.PredictionReason</div>
                            </td>
                            <td>
                                @if (isOverdue)
                                {
                                    <span class="app-badge app-badge-danger">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Overdue
                                    </span>
                                }
                                else
                                {
                                    <span class="app-badge app-badge-warning">
                                        <i class="bi bi-clock-history me-1"></i>Due Soon
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-controller="ServiceJob" asp-action="Create" asp-route-vehicleId="@item.Id" class="app-btn app-btn-primary app-btn-sm text-nowrap">
                                    <i class="bi bi-calendar-plus me-1"></i>Book Job
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Operations Hub Grid -->
<h4 class="text-white fw-bold mb-3"><i class="bi bi-grid-fill me-2 text-info"></i>Workshop Operations Directory</h4>
<div class="row row-cols-1 row-cols-md-3 g-3">
    <div class="col">
        <div class="app-card h-100">
            <h5 class="text-white fw-bold mb-2"><i class="bi bi-person-lines-fill me-2 text-info"></i>Customers &amp; Vehicles</h5>
            <p class="app-page-subtitle">Register a customer, add a vehicle, or search by plate number.</p>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <a asp-controller="Customer" asp-action="Index" class="app-btn app-btn-outline app-btn-sm">Open Customers</a>
                <a asp-controller="Vehicle" asp-action="Index" class="app-btn app-btn-outline app-btn-sm">Open Vehicles</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="app-card h-100">
            <h5 class="text-white fw-bold mb-2"><i class="bi bi-wrench-adjustable me-2 text-info"></i>Service Jobs</h5>
            <p class="app-page-subtitle">Open a new job, check status, or review the job list.</p>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <a asp-controller="ServiceJob" asp-action="Index" class="app-btn app-btn-outline app-btn-sm">Open Service Jobs</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="app-card h-100">
            <h5 class="text-white fw-bold mb-2"><i class="bi bi-receipt me-2 text-info"></i>Billing</h5>
            <p class="app-page-subtitle">Generate an invoice for a completed job and record payment.</p>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <a asp-controller="Billing" asp-action="Index" class="app-btn app-btn-outline app-btn-sm">Open Billing</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="app-card h-100">
            <h5 class="text-white fw-bold mb-2"><i class="bi bi-box-seam me-2 text-info"></i>Parts</h5>
            <p class="app-page-subtitle">Check stock levels before promising a completion date.</p>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <a asp-controller="Parts" asp-action="Index" class="app-btn app-btn-outline app-btn-sm">Open Parts</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="app-card h-100">
            <h5 class="text-white fw-bold mb-2"><i class="bi bi-bell me-2 text-info"></i>Notifications</h5>
            <p class="app-page-subtitle">Approve or reject notifications before they are sent to customers.</p>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <a asp-controller="Notification" asp-action="Index" class="app-btn app-btn-outline app-btn-sm">Open Notifications</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="app-card h-100">
            <h5 class="text-white fw-bold mb-2"><i class="bi bi-graph-up me-2 text-info"></i>Reports</h5>
            <p class="app-page-subtitle">Revenue, mechanic workload, and low-stock reports.</p>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <a asp-controller="Report" asp-action="Index" class="app-btn app-btn-outline app-btn-sm">Open Reports</a>
            </div>
        </div>
    </div>
</div>
