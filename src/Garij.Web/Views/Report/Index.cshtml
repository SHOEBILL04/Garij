@{
    ViewData["Title"] = "Executive Business Reports";
}

<div class="app-page-header">
    <div>
        <h1 class="app-page-title">Executive Business Reports</h1>
        <p class="app-page-subtitle">Financial performance, inventory consumption, and mechanic productivity analytics.</p>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-3">
    <div class="col">
        <div class="app-card h-100 d-flex flex-column justify-content-between p-4 border border-secondary border-opacity-25">
            <div>
                <div class="rounded-circle d-flex align-items-center justify-content-center bg-info bg-opacity-10 mb-3" style="width: 44px; height: 44px; border: 1px solid rgba(6, 182, 212, 0.4);">
                    <i class="bi bi-graph-up-arrow fs-5 text-info"></i>
                </div>
                <h5 class="text-white fw-bold mb-2">Monthly Revenue</h5>
                <p class="text-secondary small mb-3">Accrual-basis billed revenue side-by-side with cash-basis payments collected, ticket counts, and average order values.</p>
            </div>
            <a asp-action="Revenue" class="app-btn app-btn-primary app-btn-sm w-100 text-center">Open Revenue Report</a>
        </div>
    </div>
    <div class="col">
        <div class="app-card h-100 d-flex flex-column justify-content-between p-4 border border-secondary border-opacity-25">
            <div>
                <div class="rounded-circle d-flex align-items-center justify-content-center bg-info bg-opacity-10 mb-3" style="width: 44px; height: 44px; border: 1px solid rgba(6, 182, 212, 0.4);">
                    <i class="bi bi-pie-chart-fill fs-5 text-info"></i>
                </div>
                <h5 class="text-white fw-bold mb-2">Part Consumption</h5>
                <p class="text-secondary small mb-3">Inventory consumption rankings, total parts spend, and real-time replenishment alerts anchored to job completion dates.</p>
            </div>
            <a asp-action="PartConsumption" class="app-btn app-btn-primary app-btn-sm w-100 text-center">Open Consumption Report</a>
        </div>
    </div>
    <div class="col">
        <div class="app-card h-100 d-flex flex-column justify-content-between p-4 border border-secondary border-opacity-25">
            <div>
                <div class="rounded-circle d-flex align-items-center justify-content-center bg-info bg-opacity-10 mb-3" style="width: 44px; height: 44px; border: 1px solid rgba(6, 182, 212, 0.4);">
                    <i class="bi bi-person-workspace fs-5 text-info"></i>
                </div>
                <h5 class="text-white fw-bold mb-2">Mechanic Workload</h5>
                <p class="text-secondary small mb-3">Active and completed job ticket volume per technician, Lead vs Assistant breakdown, and shop productivity shares.</p>
            </div>
            <a asp-action="MechanicWorkload" class="app-btn app-btn-primary app-btn-sm w-100 text-center">Open Workload Report</a>
        </div>
    </div>
    <div class="col">
        <div class="app-card h-100 d-flex flex-column justify-content-between p-4 border border-secondary border-opacity-25">
            <div>
                <div class="rounded-circle d-flex align-items-center justify-content-center bg-warning bg-opacity-10 mb-3" style="width: 44px; height: 44px; border: 1px solid rgba(234, 179, 8, 0.4);">
                    <i class="bi bi-box-seam fs-5 text-warning"></i>
                </div>
                <h5 class="text-white fw-bold mb-2">Low Stock Catalog</h5>
                <p class="text-secondary small mb-3">Parts inventory catalog items currently at or below minimum threshold reorder levels.</p>
            </div>
            <a asp-action="LowStock" class="app-btn app-btn-outline app-btn-sm w-100 text-center">View Reorder List</a>
        </div>
    </div>
</div>
