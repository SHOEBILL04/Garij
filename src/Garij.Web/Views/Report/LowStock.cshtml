@{
    ViewData["Title"] = "Low Stock Report";
}

<div class="app-page-header">
    <div>
        <h1 class="app-page-title">Low Stock Report</h1>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Parts" asp-action="Index" class="app-btn app-btn-outline">View Parts Inventory</a>
        <a asp-action="Index" class="app-btn app-btn-outline">Back to Reports</a>
    </div>
</div>

<div class="app-card">
