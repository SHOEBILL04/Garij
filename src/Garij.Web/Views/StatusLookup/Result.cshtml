@model IEnumerable<ServiceHistoryDto>
@{
    ViewData["Title"] = "Service History";
    var vehicle = ViewBag.Vehicle as VehicleDto;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Service History</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">New Search</a>
</div>

@if (vehicle is null)
{
    <div class="alert alert-warning">No vehicle was found for plate @ViewBag.SearchPlate.</div>
}
else
{
    <div class="mb-3">
        <strong>@vehicle.LicensePlateNumber</strong>
        <span class="text-muted">@vehicle.Year @vehicle.Make @vehicle.Model</span>
    </div>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Booking</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Completed</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var job in Model)
            {
                <tr>
                    <td>@job.BookingReference</td>
                    <td>@job.JobType</td>
                    <td><span class="badge bg-secondary">@job.Status</span></td>
                    <td>@job.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                    <td>@(job.CompletedAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "Pending")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No service history has been recorded for this vehicle yet.</div>
    }
}
