@model InvoiceDto
@using Garij.Domain.Enums

@{
    ViewData["Title"] = "Record Payment";
}

<div class="app-page-header">
    <div>
        <h1 class="app-page-title">Record Payment</h1>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="app-card">
            <h2 class="app-card-heading"><i class="bi bi-cash-coin me-2 text-info"></i>Record Payment</h2>

            <dl class="row mb-4">
                <dt class="col-sm-5 app-page-subtitle">Invoice:</dt>
                <dd class="col-sm-7 text-white font-monospace">@Model.InvoiceNumber</dd>

                <dt class="col-sm-5 app-page-subtitle">Total:</dt>
                <dd class="col-sm-7 text-white">@Model.TotalAmount.ToString("C")</dd>

                <dt class="col-sm-5 app-page-subtitle">Already Paid:</dt>
                <dd class="col-sm-7 text-white">@Model.AmountPaid.ToString("C")</dd>

                <dt class="col-sm-5 fw-bold text-white">Outstanding:</dt>
                <dd class="col-sm-7 fw-bold mb-0" style="color:#f87171;">@Model.OutstandingBalance.ToString("C")</dd>
            </dl>

            @if (Model.OutstandingBalance <= 0)
            {
                <p style="color:#4ade80;"><i class="bi bi-check-circle-fill me-1"></i> This invoice is fully paid.</p>
                <a asp-action="Details" asp-route-id="@Model.Id" class="app-btn app-btn-outline">Back to Invoice</a>
            }
            else
            {
                <form asp-action="RecordPayment" asp-route-invoiceId="@Model.Id" method="post">
                    <div asp-validation-summary="ModelOnly" class="app-alert-danger" role="alert"></div>

                    <div class="app-form-group">
                        <label for="Amount" class="app-form-label">Amount</label>
                        <input type="number" step="0.01" min="0.01" max="@Model.OutstandingBalance" name="Amount" id="Amount" class="app-form-control" placeholder="e.g. @Model.OutstandingBalance.ToString("0.00")" required />
                        <div class="app-page-subtitle small mt-1">Up to the outstanding balance of @Model.OutstandingBalance.ToString("C").</div>
                    </div>

                    <div class="app-form-group">
                        <label for="PaymentMethod" class="app-form-label">Payment Method</label>
                        <select name="PaymentMethod" id="PaymentMethod" class="app-form-select" asp-items="Html.GetEnumSelectList<PaymentMethod>()"></select>
                    </div>

                    <div class="app-form-group">
                        <label for="TransactionReference" class="app-form-label">Transaction Reference</label>
                        <input type="text" name="TransactionReference" id="TransactionReference" class="app-form-control" placeholder="e.g. receipt or card slip number" />
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="app-btn app-btn-outline">Cancel</a>
                        <button type="submit" class="app-btn app-btn-primary"><i class="bi bi-check-circle"></i> Record Payment</button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>
