                        </p>
                    </div>
                    <div class="border-top border-secondary border-opacity-25 pt-3 d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-info text-dark fw-bold d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            SK
                        </div>
                        <div>
                            <strong class="text-white d-block">Sarah Jenkins</strong>
                            <span class="text-secondary small">Vehicle Owner &bull; Daily Commuter</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Navigation Buttons -->
        <div class="text-center pt-3">
            <a asp-controller="Home" asp-action="Pricing" class="btn btn-info px-4 py-2 fw-bold text-dark rounded-pill me-2">
                <i class="bi bi-tag-fill me-2"></i>Check Lifetime Pricing
            </a>
            <a asp-controller="Purchase" asp-action="Index" class="btn btn-outline-info px-4 py-2 fw-bold rounded-pill">
                <i class="bi bi-cart-check-fill me-2"></i>Buy Lifetime License
            </a>
        </div>

    </div>
</div>
