@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Customer Reviews & Testimonials — Garij";
}

<div class="landing-subpage-container py-5">
    <div class="container px-lg-5 py-4">

        <!-- Header -->
        <div class="text-center mb-5 reveal">
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" style="background: rgba(6, 182, 212, 0.15); border: 1px solid rgba(6, 182, 212, 0.4);">
                <i class="bi bi-star-fill text-warning"></i>
                <span class="text-info fw-bold small letter-spacing-2 text-uppercase">Verified Client Experiences</span>
            </div>
            <h1 class="text-white fw-extrabold display-4 mb-3">WHAT OUR CLIENTS SAY</h1>
            <p class="text-secondary mx-auto fs-5" style="max-width: 720px;">
                From everyday vehicle owners to commercial fleet directors and garage workshop owners, hear why Garij is the benchmark in modern automotive excellence.
            </p>
        </div>

        <!-- Trust Stats Strip -->
        <div class="row g-3 text-center mb-5">
            <div class="col-6 col-md-3">
                <div class="p-4 rounded-4 bg-dark bg-opacity-50 border border-secondary border-opacity-25">
                    <div class="display-5 fw-extrabold text-info">99.4%</div>
                    <span class="text-secondary small fw-semibold text-uppercase">Customer Satisfaction</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-4 rounded-4 bg-dark bg-opacity-50 border border-secondary border-opacity-25">
                    <div class="display-5 fw-extrabold text-info">4,800+</div>
                    <span class="text-secondary small fw-semibold text-uppercase">Vehicles Restored</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-4 rounded-4 bg-dark bg-opacity-50 border border-secondary border-opacity-25">
                    <div class="display-5 fw-extrabold text-info">25 Yrs</div>
                    <span class="text-secondary small fw-semibold text-uppercase">Proven Legacy</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-4 rounded-4 bg-dark bg-opacity-50 border border-secondary border-opacity-25">
                    <div class="display-5 fw-extrabold text-info">5.0 ★</div>
                    <span class="text-secondary small fw-semibold text-uppercase">Average Workshop Rating</span>
                </div>
            </div>
        </div>

        <!-- Testimonials Cards Grid -->
        <div class="row g-4 mb-5">
            <div class="col-md-6 col-lg-4">
                <div class="p-4 rounded-4 bg-dark bg-opacity-75 border border-secondary border-opacity-25 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="text-warning mb-3">
                            <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                        </div>
                        <p class="text-light fst-italic mb-4">
                            "Switching our entire workshop to Garij eliminated lost work orders and parts discrepancies. The one-time buyout saved our garage thousands compared to monthly SaaS subscriptions."
                        </p>
                    </div>
                    <div class="border-top border-secondary border-opacity-25 pt-3 d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-info text-dark fw-bold d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            BA
                        </div>
                        <div>
                            <strong class="text-white d-block">Bill Alvarado</strong>
                            <span class="text-secondary small">Workshop Manager &bull; Alvarado Performance</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="p-4 rounded-4 bg-dark bg-opacity-75 border border-secondary border-opacity-25 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="text-warning mb-3">
                            <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                        </div>
                        <p class="text-light fst-italic mb-4">
                            "The mechanic job board on tablets is brilliant. Our mechanics advance jobs with a tap, log genuine parts immediately, and invoices generate without clerical errors."
                        </p>
                    </div>
                    <div class="border-top border-secondary border-opacity-25 pt-3 d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-info text-dark fw-bold d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            AW
                        </div>
                        <div>
                            <strong class="text-white d-block">Alberta Wilson</strong>
                            <span class="text-secondary small">Fleet Operations Director &bull; Metro Logistics</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="p-4 rounded-4 bg-dark bg-opacity-75 border border-secondary border-opacity-25 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="text-warning mb-3">
                            <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                        </div>
                        <p class="text-light fst-italic mb-4">
                            "Customers love the live status lookup. They check their repair stage on their phone instead of calling the front desk every twenty minutes. Total game-changer."
                        </p>
                    </div>
                    <div class="border-top border-secondary border-opacity-25 pt-3 d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-info text-dark fw-bold d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            ZF
                        </div>
                        <div>
                            <strong class="text-white d-block">Zachary Fernandez</strong>
                            <span class="text-secondary small">Service Center Director &bull; Apex Eurobay</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="p-4 rounded-4 bg-dark bg-opacity-75 border border-secondary border-opacity-25 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="text-warning mb-3">
                            <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                        </div>
                        <p class="text-light fst-italic mb-4">
                            "Brought my twin-turbo V8 in for custom dyno tuning and brake upgrade. The diagnostic breakdown was thorough, transparent, and delivered on time."
                        </p>
                    </div>
                    <div class="border-top border-secondary border-opacity-25 pt-3 d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-info text-dark fw-bold d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            MC
                        </div>
                        <div>
                            <strong class="text-white d-block">Michael Chang</strong>
                            <span class="text-secondary small">Vehicle Owner &bull; Track Enthusiast</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="p-4 rounded-4 bg-dark bg-opacity-75 border border-secondary border-opacity-25 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="text-warning mb-3">
                            <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                        </div>
                        <p class="text-light fst-italic mb-4">
