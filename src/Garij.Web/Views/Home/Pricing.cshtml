@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Lifetime License Pricing — One-Time Buyout — Garij";
}

<div class="landing-subpage-container py-5">
    <div class="container px-lg-5 py-4">

        <!-- Header -->
        <div class="text-center mb-5 reveal">
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" style="background: rgba(6, 182, 212, 0.15); border: 1px solid rgba(6, 182, 212, 0.4);">
                <i class="bi bi-shield-check text-info"></i>
                <span class="text-info fw-bold small letter-spacing-2 text-uppercase">One-Time Buyout • Zero Subscriptions</span>
            </div>
            <h1 class="text-white fw-extrabold display-4 mb-3">TRANSPARENT LIFETIME PRICING</h1>
            <p class="text-secondary mx-auto fs-5" style="max-width: 720px;">
                Invest once and own your workshop management system forever. No monthly per-seat fees, no cloud lock-in, and instant digital key delivery.
            </p>
        </div>

        <!-- Pricing Card Centerpiece -->
        <div class="row justify-content-center mb-5">
            <div class="col-lg-8">
                <div class="p-4 p-md-5 rounded-4 border border-info border-opacity-30 shadow-lg position-relative overflow-hidden pricing-main-card">
                    
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                        <div>
                            <span class="text-info small fw-bold text-uppercase letter-spacing-2">COMMERCIAL LIFETIME LICENSE</span>
                            <h2 class="text-white fw-bold display-6 mb-1">Garij Pro Workshop Edition</h2>
                            <p class="text-secondary small mb-0">Unlimited mechanics, receptionists, service bays, and customer telemetry.</p>
                        </div>
                        <span class="badge bg-info text-dark px-3 py-2 rounded-pill fw-bold fs-6">LIFETIME ACCESS</span>
                    </div>

                    <!-- Price Display -->
                    <div class="d-flex align-items-baseline gap-3 mb-4 pb-4 border-bottom border-secondary border-opacity-25">
                        <span class="text-info display-3 fw-extrabold">$499</span>
                        <span class="text-secondary font-monospace fs-5">USD</span>
                        <span class="badge bg-dark border border-secondary text-white-50 ms-auto">ONE-TIME PAYMENT</span>
                    </div>

                    <!-- Comparison Table Grid -->
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <h6 class="text-white fw-bold small text-uppercase letter-spacing-2 mb-3">
                                <i class="bi bi-check-circle-fill text-info me-2"></i>Included Features:
                            </h6>
                            <ul class="list-unstyled text-light small d-flex flex-column gap-2 mb-0">
                                <li class="d-flex align-items-center gap-2">
                                    <i class="bi bi-check2 text-info fs-5"></i>
                                    <span><strong>Unlimited Service Jobs</strong> &amp; Vehicle History</span>
                                </li>
                                <li class="d-flex align-items-center gap-2">
                                    <i class="bi bi-check2 text-info fs-5"></i>
                                    <span><strong>Mechanic Tablet Job Board</strong> (Touch-optimized)</span>
                                </li>
                                <li class="d-flex align-items-center gap-2">
                                    <i class="bi bi-check2 text-info fs-5"></i>
                                    <span><strong>Parts Inventory Control</strong> with low-stock alerts</span>
                                </li>
                                <li class="d-flex align-items-center gap-2">
                                    <i class="bi bi-check2 text-info fs-5"></i>
                                    <span><strong>Transactional Invoicing</strong> with atomic rollback</span>
                                </li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-white fw-bold small text-uppercase letter-spacing-2 mb-3">
                                <i class="bi bi-shield-lock-fill text-info me-2"></i>System Benefits:
                            </h6>
                            <ul class="list-unstyled text-light small d-flex flex-column gap-2 mb-0">
                                <li class="d-flex align-items-center gap-2">
                                    <i class="bi bi-check2 text-info fs-5"></i>
                                    <span><strong>Gemini AI Diagnostics Engine</strong></span>
                                </li>
                                <li class="d-flex align-items-center gap-2">
                                    <i class="bi bi-check2 text-info fs-5"></i>
                                    <span><strong>Public Customer Telemetry Lookup</strong></span>
                                </li>
                                <li class="d-flex align-items-center gap-2">
                                    <i class="bi bi-check2 text-info fs-5"></i>
                                    <span><strong>Zero Monthly Subscription Fees</strong></span>
                                </li>
                                <li class="d-flex align-items-center gap-2">
                                    <i class="bi bi-check2 text-info fs-5"></i>
                                    <span><strong>Lifetime Updates</strong> &amp; Certificate Delivery</span>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-grid gap-3 pt-2">
                        <a asp-controller="Purchase" asp-action="Index" class="btn btn-info btn-lg fw-bold py-3 text-dark text-uppercase letter-spacing-1 shadow">
                            <i class="bi bi-cart-check-fill me-2"></i>Proceed to Buyout ($499 USD)
                        </a>

                        <!-- Demo Key Card -->
                        <div class="p-3 rounded-3 bg-dark bg-opacity-75 border border-info border-opacity-25 text-center">
                            <span class="text-secondary small d-block mb-1">
                                <i class="bi bi-key-fill text-info me-1"></i> Testing the platform? Use demo key:
                            </span>
                            <span class="badge bg-secondary text-info font-monospace fs-6 px-3 py-1">GRJ-DEMO-2026-KEY</span>
                            <small class="text-white-50 d-block mt-1">Activate on checkout page to test without entering payment details.</small>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- FAQ Section -->
        <div class="my-5 py-4">
            <div class="text-center mb-5">
                <span class="text-info small fw-bold text-uppercase letter-spacing-2">Frequently Asked Questions</span>
                <h3 class="text-white fw-bold display-6 mt-1">LIFETIME LICENSE CLARIFICATIONS</h3>
            </div>

            <div class="row g-4 justify-content-center">
                <div class="col-lg-8">
                    <div class="accordion accordion-flush" id="pricingFaq">
                        
                        <div class="p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-25 mb-3">
                            <h5 class="text-white fw-bold mb-2">
                                <i class="bi bi-question-circle text-info me-2"></i>Are there any recurring monthly or annual costs?
                            </h5>
                            <p class="text-secondary small mb-0">
                                No. The $499 USD purchase is a true one-time buyout. You receive a digital lifetime license key that permanently unlocks all workshop capabilities without any recurring charges.
                            </p>
                        </div>

                        <div class="p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-25 mb-3">
                            <h5 class="text-white fw-bold mb-2">
                                <i class="bi bi-question-circle text-info me-2"></i>Can I visit public pages (Home, About, Services) without buying?
                            </h5>
                            <p class="text-secondary small mb-0">
                                Absolutely. All presentation pages (Home, About, Services, Testimonials, Pricing, and the public Vehicle Status Lookup) are completely free and open to everyone, whether you are logged out, logged in, or evaluating the system.
                            </p>
                        </div>

                        <div class="p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-25 mb-3">
                            <h5 class="text-white fw-bold mb-2">
                                <i class="bi bi-question-circle text-info me-2"></i>What is locked if I haven't paid?
                            </h5>
                            <p class="text-secondary small mb-0">
                                The internal workshop operational management tools (Customer Records, Vehicle Registry, Mechanic Job Boards, Parts Inventory Management, Invoicing, and Accounting Reports) remain locked until a license key is activated.
                            </p>
                        </div>

                        <div class="p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-25">
                            <h5 class="text-white fw-bold mb-2">
                                <i class="bi bi-question-circle text-info me-2"></i>How do I test before buying?
                            </h5>
                            <p class="text-secondary small mb-0">
                                You can use the instant test checkout button on the checkout page or enter the demo key <code>GRJ-DEMO-2026-KEY</code> in the Activate Key tab to immediately unlock all workshop tools for testing.
                            </p>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
