@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Specialized Workshop Services — Garij";
}

<div class="landing-subpage-container py-5">
    <div class="container px-lg-5 py-4">

        <!-- Header -->
        <div class="text-center mb-5 reveal">
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" style="background: rgba(6, 182, 212, 0.15); border: 1px solid rgba(6, 182, 212, 0.4);">
                <i class="bi bi-gear-fill text-info"></i>
                <span class="text-info fw-bold small letter-spacing-2 text-uppercase">Precision Engineering &amp; Tuning</span>
            </div>
            <h1 class="text-white fw-extrabold display-4 mb-3">SPECIALIZED WORKSHOP SERVICES</h1>
            <p class="text-secondary mx-auto fs-5" style="max-width: 720px;">
                Comprehensive automotive maintenance, performance upgrades, and digital diagnostic telemetry carried out by certified master mechanics.
            </p>
        </div>

        <!-- 6 Specialized Service Cards Grid -->
        <div class="row g-4 mb-5">
            <!-- 1. Engine Overhaul -->
            <div class="col-md-6 col-lg-4">
                <div class="p-4 rounded-4 bg-dark bg-opacity-75 border border-secondary border-opacity-25 h-100 d-flex flex-column">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <i class="bi bi-wrench-adjustable-circle text-info fs-1"></i>
                        <span class="badge bg-secondary bg-opacity-50 text-light font-monospace small">BAY 01</span>
                    </div>
                    <h4 class="text-white fw-bold mb-2">Engine Overhaul &amp; Rebuild</h4>
                    <p class="text-secondary small flex-grow-1">
                        Full teardown, ultrasonic cylinder head cleaning, high-performance piston seating, crankshaft balancing, and precision compression testing.
                    </p>
                    <ul class="list-unstyled text-light small d-flex flex-column gap-2 mb-3">
                        <li><i class="bi bi-check2 text-info me-2"></i>Multi-point compression testing</li>
                        <li><i class="bi bi-check2 text-info me-2"></i>Timing chain &amp; belt replacement</li>
                        <li><i class="bi bi-check2 text-info me-2"></i>Genuine OEM gaskets &amp; seals</li>
                    </ul>
                </div>
            </div>

            <!-- 2. ECU Tuning -->
            <div class="col-md-6 col-lg-4">
                <div class="p-4 rounded-4 bg-dark bg-opacity-75 border border-secondary border-opacity-25 h-100 d-flex flex-column">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <i class="bi bi-cpu text-info fs-1"></i>
                        <span class="badge bg-secondary bg-opacity-50 text-light font-monospace small">BAY 02</span>
                    </div>
                    <h4 class="text-white fw-bold mb-2">Performance ECU Tuning</h4>
                    <p class="text-secondary small flex-grow-1">
                        Custom Stage 1, 2, and 3 ECU remaps optimized for power output, linear throttle response, and fuel efficiency via live telemetry feedback.
                    </p>
                    <ul class="list-unstyled text-light small d-flex flex-column gap-2 mb-3">
                        <li><i class="bi bi-check2 text-info me-2"></i>Dyno-calibrated fuel maps</li>
                        <li><i class="bi bi-check2 text-info me-2"></i>Speed limiter &amp; rev adjustments</li>
                        <li><i class="bi bi-check2 text-info me-2"></i>Pop, bang &amp; flame map integration</li>
                    </ul>
                </div>
            </div>

            <!-- 3. Brembo & Disc Brakes -->
            <div class="col-md-6 col-lg-4">
                <div class="p-4 rounded-4 bg-dark bg-opacity-75 border border-secondary border-opacity-25 h-100 d-flex flex-column">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <i class="bi bi-disc text-info fs-1"></i>
                        <span class="badge bg-secondary bg-opacity-50 text-light font-monospace small">BAY 03</span>
                    </div>
                    <h4 class="text-white fw-bold mb-2">Brembo &amp; Performance Brakes</h4>
                    <p class="text-secondary small flex-grow-1">
                        High-carbon slotted rotors, multi-piston monoblock calipers, braided stainless-steel lines, and DOT 5.1 high-temperature fluid flushes.
                    </p>
                    <ul class="list-unstyled text-light small d-flex flex-column gap-2 mb-3">
                        <li><i class="bi bi-check2 text-info me-2"></i>Brembo 6-piston big brake kits</li>
                        <li><i class="bi bi-check2 text-info me-2"></i>Ceramic low-dust pads</li>
                        <li><i class="bi bi-check2 text-info me-2"></i>Laser rotor thickness verification</li>
                    </ul>
                </div>
            </div>

            <!-- 4. Transmission & Drivetrain -->
            <div class="col-md-6 col-lg-4">
                <div class="p-4 rounded-4 bg-dark bg-opacity-75 border border-secondary border-opacity-25 h-100 d-flex flex-column">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <i class="bi bi-speedometer2 text-info fs-1"></i>
                        <span class="badge bg-secondary bg-opacity-50 text-light font-monospace small">BAY 04</span>
                    </div>
                    <h4 class="text-white fw-bold mb-2">Transmission &amp; Drivetrain</h4>
                    <p class="text-secondary small flex-grow-1">
                        Dual-clutch (DCT), manual, and automatic transmission overhauls, torque converter recalibration, and limited-slip differential (LSD) tuning.
                    </p>
                    <ul class="list-unstyled text-light small d-flex flex-column gap-2 mb-3">
                        <li><i class="bi bi-check2 text-info me-2"></i>Clutch disc &amp; flywheel replacement</li>
                        <li><i class="bi bi-check2 text-info me-2"></i>High-pressure valve body cleaning</li>
                        <li><i class="bi bi-check2 text-info me-2"></i>LSD preload &amp; gear alignment</li>
                    </ul>
                </div>
            </div>

            <!-- 5. Neon & Custom Lighting -->
            <div class="col-md-6 col-lg-4">
                <div class="p-4 rounded-4 bg-dark bg-opacity-75 border border-secondary border-opacity-25 h-100 d-flex flex-column">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <i class="bi bi-lightning-charge text-info fs-1"></i>
                        <span class="badge bg-secondary bg-opacity-50 text-light font-monospace small">BAY 05</span>
                    </div>
                    <h4 class="text-white fw-bold mb-2">Custom Neon &amp; Underglow</h4>
                    <p class="text-secondary small flex-grow-1">
                        App-controlled RGB multi-zone LED underglow, angel eyes retrofit, laser headlight restoration, and custom ambient interior illumination.
                    </p>
                    <ul class="list-unstyled text-light small d-flex flex-column gap-2 mb-3">
                        <li><i class="bi bi-check2 text-info me-2"></i>IP68 waterproof silicone housings</li>
                        <li><i class="bi bi-check2 text-info me-2"></i>Smartphone Bluetooth controller</li>
                        <li><i class="bi bi-check2 text-info me-2"></i>Custom daytime running lights (DRL)</li>
                    </ul>
                </div>
            </div>

            <!-- 6. Suspension & Chassis -->
            <div class="col-md-6 col-lg-4">
                <div class="p-4 rounded-4 bg-dark bg-opacity-75 border border-secondary border-opacity-25 h-100 d-flex flex-column">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <i class="bi bi-layers text-info fs-1"></i>
                        <span class="badge bg-secondary bg-opacity-50 text-light font-monospace small">BAY 06</span>
                    </div>
                    <h4 class="text-white fw-bold mb-2">Coilover &amp; Suspension Tuning</h4>
                    <p class="text-secondary small flex-grow-1">
                        Corner-weight balancing, adjustable coilover height calibration, polyurethane bushing installation, and 3D computer laser wheel alignment.
                    </p>
                    <ul class="list-unstyled text-light small d-flex flex-column gap-2 mb-3">
                        <li><i class="bi bi-check2 text-info me-2"></i>3D 4-wheel laser alignment</li>
                        <li><i class="bi bi-check2 text-info me-2"></i>Camber &amp; toe geometry setup</li>
                        <li><i class="bi bi-check2 text-info me-2"></i>Anti-roll sway bar upgrades</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Service Status Tracker Callout -->
        <div class="p-4 p-md-5 rounded-4 border border-secondary border-opacity-25 mb-5 subpage-callout-card">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <span class="badge bg-info text-dark px-3 py-1 fw-bold rounded-pill mb-2">REAL-TIME PORTAL</span>
                    <h3 class="text-white fw-bold mb-2">VEHICLE ALREADY IN OUR BAY?</h3>
                    <p class="text-secondary mb-0">
                        Track your vehicle's live inspection findings, mechanic repair notes, parts used, and job stages with zero hassle using your license plate or booking reference.
                    </p>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <a href="/#status-tracker" class="btn btn-info btn-lg px-4 fw-bold text-dark rounded-pill shadow">
                        <i class="bi bi-search me-2"></i>Track Repair Status
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>
