@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "About Workshop & Engineering — Garij";
}

<div class="landing-subpage-container py-5">
    <div class="container px-lg-5 py-4">

        <!-- Breadcrumb & Header -->
        <div class="text-center mb-5 reveal">
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" style="background: rgba(6, 182, 212, 0.15); border: 1px solid rgba(6, 182, 212, 0.4);">
                <i class="bi bi-award text-info"></i>
                <span class="text-info fw-bold small letter-spacing-2 text-uppercase">Automotive Mastery &amp; Heritage</span>
            </div>
            <h1 class="text-white fw-extrabold display-4 mb-3">ABOUT GARIJ WORKSHOP</h1>
            <p class="text-secondary mx-auto fs-5" style="max-width: 720px;">
                Where old-school mechanical craftsmanship meets next-generation AI telemetry diagnostics. Built for vehicle owners and garage operators who refuse to compromise on quality.
            </p>
        </div>

        <!-- Main Narrative Section -->
        <div class="row align-items-center g-5 mb-5">
            <div class="col-lg-6 reveal-left">
                <span class="text-info small fw-bold text-uppercase letter-spacing-2">Our Foundation</span>
                <h2 class="text-white fw-bold display-6 mt-1 mb-3">25 YEARS OF UNCOMPROMISING PRECISION</h2>
                <p class="text-secondary mb-4">
                    Founded in 1983 as a dedicated racing and tuning bay, Garij has evolved into a premier full-service automotive engineering center. We handle everything from factory-spec maintenance to full engine overhauls and custom ECU performance remapping.
                </p>
                <p class="text-secondary mb-4">
                    Our platform integrates diagnostic telemetry, real-time parts inventory tracking, and Google Gemini AI diagnostics to ensure every vehicle leaves our bays in peak condition.
                </p>

                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="p-3 rounded-3 bg-dark bg-opacity-75 border border-secondary border-opacity-25 h-100">
                            <div class="d-flex align-items-center gap-3">
                                <i class="bi bi-shield-check text-info fs-3"></i>
                                <div>
                                    <h6 class="text-white fw-bold mb-0">100% Data Integrity</h6>
                                    <span class="text-secondary small">Atomic transaction audit trails</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 rounded-3 bg-dark bg-opacity-75 border border-secondary border-opacity-25 h-100">
                            <div class="d-flex align-items-center gap-3">
                                <i class="bi bi-tools text-info fs-3"></i>
                                <div>
                                    <h6 class="text-white fw-bold mb-0">Master Mechanics</h6>
                                    <span class="text-secondary small">ASE certified senior specialists</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 text-center reveal-right">
                <div class="position-relative p-3 dark-only">
                    <img src="~/images/renovation-car.png" alt="High-Performance Tuned Vehicle" class="img-fluid rounded-4 shadow-lg" style="max-height: 380px; object-fit: contain;" />
                </div>
                <!-- Minimal Elegant Card for Light Mode (Zero Images) -->
                <div class="light-only p-4 rounded-4 text-start" style="background: #ffffff; border: 1.5px solid #e2e8f0; box-shadow: 0 10px 30px rgba(0,0,0,0.04);">
                    <span class="badge rounded-pill px-3 py-1 mb-3 text-uppercase fw-bold" style="background: rgba(2, 132, 199, 0.1); color: #0284c7; border: 1px solid rgba(2, 132, 199, 0.25);">Workshop Standard</span>
                    <h4 class="fw-bold text-dark mb-3">Pioneering Automotive Intelligence</h4>
                    <p class="text-secondary small mb-4">Every vehicle entering Garij undergoes digital onboarding, OBD-II telemetry scan, multi-point inspection, and atomic parts tracking.</p>
                    <div class="d-flex flex-column gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-cpu text-info fs-4"></i>
                            <div>
                                <strong class="d-block text-dark small">AI Diagnostic Assistant</strong>
                                <span class="text-muted small">Real-time symptom analysis with Google Gemini</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-clock-history text-info fs-4"></i>
                            <div>
                                <strong class="d-block text-dark small">Live Public Telemetry</strong>
                                <span class="text-muted small">Clients can track repair stages from any smartphone</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Four Pillars of Excellence -->
        <div class="my-5 py-4">
            <div class="text-center mb-5">
                <span class="text-info small fw-bold text-uppercase letter-spacing-2">Why Choose Garij</span>
                <h3 class="text-white fw-bold display-6 mt-1">ENGINEERED FOR TOTAL CONFIDENCE</h3>
            </div>

            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <div class="p-4 rounded-4 bg-dark bg-opacity-50 border border-secondary border-opacity-25 h-100">
                        <i class="bi bi-cpu text-info fs-2 mb-3 d-block"></i>
                        <h5 class="text-white fw-bold">AI Diagnostics</h5>
                        <p class="text-secondary small mb-0">
                            Automated symptom analysis and predictive maintenance powered by Google Gemini to catch issues before catastrophic failure.
                        </p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="p-4 rounded-4 bg-dark bg-opacity-50 border border-secondary border-opacity-25 h-100">
                        <i class="bi bi-box-seam text-info fs-2 mb-3 d-block"></i>
                        <h5 class="text-white fw-bold">Genuine OEM Parts</h5>
                        <p class="text-secondary small mb-0">
                            Strict inventory control with verified manufacturer part numbers and automated stock reorder thresholds.
                        </p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="p-4 rounded-4 bg-dark bg-opacity-50 border border-secondary border-opacity-25 h-100">
                        <i class="bi bi-radar text-info fs-2 mb-3 d-block"></i>
                        <h5 class="text-white fw-bold">Live Status Lookup</h5>
                        <p class="text-secondary small mb-0">
                            Customers track vehicle repair progress, inspection notes, and completed stages in real time without calling reception.
                        </p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="p-4 rounded-4 bg-dark bg-opacity-50 border border-secondary border-opacity-25 h-100">
                        <i class="bi bi-patch-check-fill text-info fs-2 mb-3 d-block"></i>
                        <h5 class="text-white fw-bold">Lifetime Software</h5>
                        <p class="text-secondary small mb-0">
                            One-time purchase model for garage managers. No recurring subscriptions, total software ownership, and free updates.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Call to Action Banner -->
        <div class="p-5 rounded-4 border border-info border-opacity-25 text-center mt-5" style="background: linear-gradient(135deg, rgba(6, 182, 212, 0.1) 0%, rgba(2, 132, 199, 0.05) 100%);">
            <h3 class="text-white fw-bold mb-3">EXPERIENCE GARIJ PRECISION TODAY</h3>
            <p class="text-secondary mx-auto mb-4" style="max-width: 600px;">
                Explore our full service lineup, track an existing vehicle repair, or unlock the management software with a one-time lifetime license.
            </p>
            <div class="d-flex justify-content-center flex-wrap gap-3">
                <a asp-controller="Home" asp-action="Services" class="btn btn-info px-4 py-2 fw-bold text-dark rounded-pill">
                    <i class="bi bi-wrench-adjustable me-2"></i>Explore Services
                </a>
                <a asp-controller="Home" asp-action="Pricing" class="btn btn-outline-info px-4 py-2 fw-bold rounded-pill">
                    <i class="bi bi-tag-fill me-2"></i>View Pricing
                </a>
                <a asp-controller="Purchase" asp-action="Index" class="btn btn-outline-light px-4 py-2 fw-bold rounded-pill">
                    <i class="bi bi-cart-check-fill me-2"></i>Buy Lifetime License
                </a>
            </div>
        </div>

    </div>
</div>
