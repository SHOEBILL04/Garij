@model Garij.Application.DTOs.MechanicAssignmentDto
@using Garij.Domain.Enums
@using Garij.Application.DTOs

@{
    ViewData["Title"] = "Assign Mechanic";
    var job = ViewBag.ServiceJob as ServiceJobDto;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white py-3">
                    <h2 class="h5 card-title mb-0"><i class="bi bi-person-plus-fill me-2"></i>Assign Mechanic to Service Job</h2>
                </div>
                <div class="card-body p-4">
                    @if (job != null)
                    {
                        <div class="alert alert-light border mb-4">
                            <div class="fw-bold text-primary mb-1">Booking Reference: @job.BookingReference</div>
                            <div class="small"><strong>Vehicle:</strong> @job.VehiclePlateNumber (@job.VehicleDescription)</div>
                            <div class="small"><strong>Customer:</strong> @job.CustomerName</div>
                            <div class="small"><strong>Status:</strong> <span class="badge bg-secondary">@job.Status</span></div>
                        </div>
                    }

                    <form asp-action="Assign" method="post">
                        <input type="hidden" asp-for="ServiceJobId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="UserId" class="form-label fw-bold">Select Mechanic</label>
                            <select asp-for="UserId" asp-items="ViewBag.Mechanics" class="form-select">
                                <option value="">-- Choose Mechanic --</option>
                            </select>
                            <span asp-validation-for="UserId" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="RoleInJob" class="form-label fw-bold">Role in Job</label>
                            <select asp-for="RoleInJob" asp-items="Html.GetEnumSelectList<RoleInJob>()" class="form-select"></select>
                            <span asp-validation-for="RoleInJob" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="ServiceJob" asp-action="Details" asp-route-id="@Model.ServiceJobId" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-success px-4"><i class="bi bi-check-lg me-1"></i> Assign Mechanic</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
