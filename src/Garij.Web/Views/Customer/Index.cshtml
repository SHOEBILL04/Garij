@model IEnumerable<CustomerDto>
@{
    ViewData["Title"] = "Customers";
}

<div class="app-page-header">
    <div>
        <h1 class="app-page-title">Customers</h1>
        <p class="app-page-subtitle">Registered customers and their vehicles.</p>
    </div>
    <a asp-action="Create" class="app-btn app-btn-primary"><i class="bi bi-person-plus"></i> Register Customer</a>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="app-alert-success"><span><i class="bi bi-check-circle-fill me-2"></i>@message</span></div>
}

<div class="app-table-wrap">
    <div class="table-responsive">
        <table class="app-table mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4">
                            <div class="app-empty-state">
                                <i class="bi bi-people"></i>
                                No customers have been registered yet.
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var customer in Model)
                    {
                        <tr>
                            <td class="text-white fw-semibold">@customer.FullName</td>
                            <td>@customer.Email</td>
                            <td>@customer.PhoneNumber</td>
                            <td class="text-end">
                                <div class="d-flex gap-2 justify-content-end flex-wrap">
                                    <a asp-action="Details" asp-route-id="@customer.Id" class="app-btn app-btn-outline app-btn-sm">Details</a>
                                    <a asp-action="Edit" asp-route-id="@customer.Id" class="app-btn app-btn-outline app-btn-sm">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@customer.Id" class="app-btn app-btn-danger app-btn-sm">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
