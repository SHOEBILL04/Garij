@model VehicleDto
@{
    ViewData["Title"] = "Edit Vehicle";
}

<div class="app-page-header">
    <div>
        <h1 class="app-page-title">Edit Vehicle</h1>
    </div>
</div>

<div class="app-card" style="max-width: 860px;">
    <form asp-action="Edit" method="post" class="row g-3">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="app-alert-danger"></div>
        <div class="col-md-6 app-form-group mb-0">
            <label asp-for="CustomerId" class="app-form-label"></label>
            <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="app-form-select"></select>
            <span asp-validation-for="CustomerId" class="app-field-error"></span>
        </div>
        <div class="col-md-6 app-form-group mb-0">
            <label asp-for="LicensePlateNumber" class="app-form-label"></label>
            <input asp-for="LicensePlateNumber" class="app-form-control" placeholder="e.g. BR-002" />
            <span asp-validation-for="LicensePlateNumber" class="app-field-error"></span>
        </div>
        <div class="col-md-4 app-form-group mb-0">
            <label asp-for="Make" class="app-form-label"></label>
            <input asp-for="Make" class="app-form-control" placeholder="e.g. Toyota" />
            <span asp-validation-for="Make" class="app-field-error"></span>
        </div>
        <div class="col-md-4 app-form-group mb-0">
            <label asp-for="Model" class="app-form-label"></label>
            <input asp-for="Model" class="app-form-control" placeholder="e.g. Corolla" />
            <span asp-validation-for="Model" class="app-field-error"></span>
        </div>
        <div class="col-md-4 app-form-group mb-0">
            <label asp-for="Year" class="app-form-label"></label>
            <input asp-for="Year" class="app-form-control" placeholder="e.g. 2022" />
            <span asp-validation-for="Year" class="app-field-error"></span>
        </div>
        <div class="col-md-6 app-form-group mb-0">
            <label asp-for="Vin" class="app-form-label"></label>
            <input asp-for="Vin" class="app-form-control" placeholder="17-character vehicle identification number" />
            <span asp-validation-for="Vin" class="app-field-error"></span>
        </div>
        <div class="col-md-6 app-form-group mb-0">
            <label asp-for="Color" class="app-form-label"></label>
            <input asp-for="Color" class="app-form-control" placeholder="e.g. White" />
            <span asp-validation-for="Color" class="app-field-error"></span>
        </div>
        <div class="col-12 d-flex gap-2 mt-2">
            <button type="submit" class="app-btn app-btn-primary">Save Changes</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="app-btn app-btn-outline">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
