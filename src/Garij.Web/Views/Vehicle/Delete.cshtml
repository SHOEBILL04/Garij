@model VehicleDto
@{
    ViewData["Title"] = "Delete Vehicle";
}

<div class="app-page-header">
    <div>
        <h1 class="app-page-title">Delete Vehicle</h1>
    </div>
</div>

<div class="app-card" style="max-width: 640px;">
    <div asp-validation-summary="ModelOnly" class="app-alert-danger"></div>
    <div class="app-alert-danger">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>Delete @Model.LicensePlateNumber (@Model.Year @Model.Make @Model.Model)? Vehicles with service history cannot be deleted.
    </div>

    <form asp-action="Delete" method="post" class="d-flex gap-2">
        <input asp-for="Id" type="hidden" />
        <button type="submit" class="app-btn app-btn-danger">Delete</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="app-btn app-btn-outline">Cancel</a>
    </form>
</div>
