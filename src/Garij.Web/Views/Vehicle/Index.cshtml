@model IEnumerable<VehicleDto>
@{
    ViewData["Title"] = "Vehicles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Vehicles</h1>
    <a asp-action="Create" class="btn btn-primary">Add Vehicle</a>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <label for="plateNumber" class="form-label">Search plate number</label>
        <input id="plateNumber" name="plateNumber" value="@ViewData["PlateNumber"]" class="form-control" placeholder="BR-002" />
    </div>
    <div class="col-md-auto align-self-end">
        <button type="submit" class="btn btn-outline-primary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Plate</th>
                <th>Vehicle</th>
                <th>Customer</th>
                <th>VIN</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var vehicle in Model)
        {
            <tr>
                <td>@vehicle.LicensePlateNumber</td>
                <td>@vehicle.Year @vehicle.Make @vehicle.Model</td>
                <td>@vehicle.CustomerName</td>
                <td>@vehicle.Vin</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@vehicle.Id" class="btn btn-sm btn-outline-primary">Details</a>
                    <a asp-action="Edit" asp-route-id="@vehicle.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@vehicle.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No vehicles matched the current search.</div>
}
