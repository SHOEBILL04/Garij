@using Garij.Application.DTOs
@model PartDto

@{
    ViewData["Title"] = "Part Details";
}

@{
    var canManage = User.IsInRole("Admin") || User.IsInRole("FrontDesk");
}

<div class="app-page-header">
    <div>
        <h1 class="app-page-title">@Model.Name</h1>
    </div>
    @if (canManage)
    {
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="app-btn app-btn-outline">Edit</a>
        </div>
    }
</div>

<div class="app-card" style="max-width: 640px;">
    <dl class="row mb-0">
        <dt class="col-sm-4 app-page-subtitle">@Html.DisplayNameFor(m => m.PartNumber)</dt>
        <dd class="col-sm-8 text-white font-monospace">@Model.PartNumber</dd>

        <dt class="col-sm-4 app-page-subtitle">@Html.DisplayNameFor(m => m.UnitPrice)</dt>
        <dd class="col-sm-8 text-white">@Model.UnitPrice.ToString("C")</dd>

        <dt class="col-sm-4 app-page-subtitle">@Html.DisplayNameFor(m => m.QuantityInStock)</dt>
        <dd class="col-sm-8 text-white">
            @Model.QuantityInStock
            @if (Model.QuantityInStock <= Model.ReorderLevel)
            {
                <span class="app-badge app-badge-warning ms-1">Low stock</span>
            }
        </dd>

        <dt class="col-sm-4 app-page-subtitle">@Html.DisplayNameFor(m => m.ReorderLevel)</dt>
        <dd class="col-sm-8 text-white mb-0">@Model.ReorderLevel</dd>
    </dl>
</div>

<a asp-action="Index" class="app-btn app-btn-outline mt-3 d-inline-flex">Back to List</a>
