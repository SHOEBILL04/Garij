@using Garij.Application.DTOs
@model PartDto

@{
    ViewData["Title"] = "Edit Part";
}

<div class="app-page-header">
    <div>
        <h1 class="app-page-title">Edit Part</h1>
    </div>
</div>

<div class="app-card" style="max-width: 640px;">
    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="app-alert-danger"></div>
        <input type="hidden" asp-for="Id" />

        <div class="app-form-group">
            <label asp-for="Name" class="app-form-label"></label>
            <input asp-for="Name" class="app-form-control" placeholder="e.g. Premium Brake Pads Front Set" />
            <span asp-validation-for="Name" class="app-field-error"></span>
        </div>

        <div class="app-form-group">
            <label asp-for="PartNumber" class="app-form-label"></label>
            <input asp-for="PartNumber" class="app-form-control" placeholder="e.g. BRK-PAD-F" />
            <span asp-validation-for="PartNumber" class="app-field-error"></span>
        </div>

        <div class="app-form-group">
            <label asp-for="UnitPrice" class="app-form-label"></label>
            <input asp-for="UnitPrice" class="app-form-control" placeholder="e.g. 60.00" />
            <span asp-validation-for="UnitPrice" class="app-field-error"></span>
        </div>

        <div class="app-form-group">
            <label asp-for="ReorderLevel" class="app-form-label"></label>
            <input asp-for="ReorderLevel" class="app-form-control" placeholder="e.g. 5" />
            <span asp-validation-for="ReorderLevel" class="app-field-error"></span>
            <div class="app-page-subtitle small mt-1">Stock quantity is adjusted from the Parts list using the +/- controls, not here.</div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="app-btn app-btn-primary">Save</button>
            <a asp-action="Index" class="app-btn app-btn-outline">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
