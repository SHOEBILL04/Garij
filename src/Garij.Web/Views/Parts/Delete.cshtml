@using Garij.Application.DTOs
@model PartDto

@{
    ViewData["Title"] = "Delete Part";
}

<h1>Delete Part</h1>

<p class="text-danger">Are you sure you want to delete this part?</p>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Name)</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.PartNumber)</dt>
    <dd class="col-sm-9">@Model.PartNumber</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.UnitPrice)</dt>
    <dd class="col-sm-9">@Model.UnitPrice.ToString("C")</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.QuantityInStock)</dt>
    <dd class="col-sm-9">@Model.QuantityInStock</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.ReorderLevel)</dt>
    <dd class="col-sm-9">@Model.ReorderLevel</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
