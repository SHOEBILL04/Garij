@model Garij.Web.Models.LoginViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign In";
}

<div class="auth-card">
    <div class="auth-icon-badge">
        <i class="bi bi-box-arrow-in-right"></i>
    </div>
    <h1 class="auth-title">Sign in to Garij</h1>
    <p class="auth-subtitle">Access your garage management dashboard</p>

    <form asp-action="Login" method="post" id="loginForm">
        <input type="hidden" asp-for="ReturnUrl" />

        <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert"></div>

        <div class="auth-field">
            <label asp-for="Email" class="visually-hidden">Email Address</label>
            <div class="auth-input-group">
                <i class="bi bi-envelope auth-input-icon"></i>
                <input asp-for="Email" class="form-control auth-input" placeholder="name@garij.com" autocomplete="username" />
            </div>
            <span asp-validation-for="Email" class="auth-field-error"></span>
        </div>

        <div class="auth-field">
            <label asp-for="Password" class="visually-hidden">Password</label>
            <div class="auth-input-group has-toggle">
                <i class="bi bi-lock auth-input-icon"></i>
                <input asp-for="Password" class="form-control auth-input" placeholder="••••••••" autocomplete="current-password" />
                <button type="button" class="auth-toggle-password" data-target="Password" aria-label="Show password">
                    <i class="bi bi-eye-slash"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="auth-field-error"></span>
        </div>

        <div class="auth-remember-row">
            <div class="form-check">
                <input asp-for="RememberMe" class="form-check-input auth-check-input" />
                <label asp-for="RememberMe" class="form-check-label text-secondary">Remember me</label>
            </div>
            <a asp-action="Register" class="auth-link">Create Account</a>
        </div>

        <button type="submit" class="auth-submit-btn">
            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
