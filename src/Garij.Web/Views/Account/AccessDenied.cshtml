@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center mt-5 text-center">
    <div class="col-md-6">
        <div class="app-card">
            <div class="mb-3" style="color:#f87171;">
                <i class="bi bi-shield-exclamation display-1"></i>
            </div>
            <h2 class="app-page-title mb-2">Access Denied</h2>
            <p class="app-page-subtitle fs-6 mb-4">You do not have permission to access this resource or module.</p>
            <div class="d-flex justify-content-center gap-2 flex-wrap">
                <a asp-controller="Dashboard" asp-action="Index" class="app-btn app-btn-primary">
                    <i class="bi bi-speedometer2"></i> Go to Dashboard
                </a>
                <a asp-controller="Account" asp-action="Login" class="app-btn app-btn-outline">
                    <i class="bi bi-box-arrow-in-right"></i> Switch Account
                </a>
            </div>
        </div>
    </div>
</div>
