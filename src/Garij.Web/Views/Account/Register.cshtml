@model Garij.Web.Models.RegisterViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Create Account";
}

<div class="auth-card auth-card-wide">
    <div class="auth-icon-badge">
        <i class="bi bi-person-plus"></i>
    </div>
    <h1 class="auth-title">Create Account</h1>
    <p class="auth-subtitle">Set up your workshop administrator account</p>

    <form asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert"></div>

        <div class="auth-field">
            <label asp-for="FullName" class="visually-hidden">Full Name</label>
            <div class="auth-input-group">
                <i class="bi bi-person auth-input-icon"></i>
                <input asp-for="FullName" class="form-control auth-input" placeholder="John Doe" />
            </div>
            <span asp-validation-for="FullName" class="auth-field-error"></span>
        </div>

        <div class="auth-input-row">
            <div class="auth-field">
                <label asp-for="Email" class="visually-hidden">Email Address</label>
                <div class="auth-input-group">
                    <i class="bi bi-envelope auth-input-icon"></i>
                    <input asp-for="Email" class="form-control auth-input" placeholder="john@garij.com" />
                </div>
                <span asp-validation-for="Email" class="auth-field-error"></span>
            </div>
            <div class="auth-field">
                <label asp-for="PhoneNumber" class="visually-hidden">Phone Number</label>
                <div class="auth-input-group">
                    <i class="bi bi-telephone auth-input-icon"></i>
                    <input asp-for="PhoneNumber" class="form-control auth-input" placeholder="+1234567890" />
                </div>
                <span asp-validation-for="PhoneNumber" class="auth-field-error"></span>
            </div>
        </div>

        <p class="auth-note">
            <i class="bi bi-shield-check me-1"></i>Create your administrator account to manage your workshop and assign employee roles.
        </p>

        <div class="auth-input-row">
            <div class="auth-field">
                <label asp-for="Password" class="visually-hidden">Password</label>
                <div class="auth-input-group has-toggle">
                    <i class="bi bi-lock auth-input-icon"></i>
                    <input asp-for="Password" class="form-control auth-input" placeholder="••••••••" autocomplete="new-password" />
                    <button type="button" class="auth-toggle-password" data-target="Password" aria-label="Show password">
                        <i class="bi bi-eye-slash"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="auth-field-error"></span>
            </div>
            <div class="auth-field">
                <label asp-for="ConfirmPassword" class="visually-hidden">Confirm Password</label>
                <div class="auth-input-group has-toggle">
                    <i class="bi bi-lock-fill auth-input-icon"></i>
                    <input asp-for="ConfirmPassword" class="form-control auth-input" placeholder="••••••••" autocomplete="new-password" />
                    <button type="button" class="auth-toggle-password" data-target="ConfirmPassword" aria-label="Show password">
                        <i class="bi bi-eye-slash"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="auth-field-error"></span>
            </div>
        </div>

        <button type="submit" class="auth-submit-btn mt-2">
            <i class="bi bi-check-circle me-2"></i>Create Account
        </button>
    </form>

    <div class="auth-footer-link">
        <a asp-action="Login" class="auth-link">Already have an account? Sign In</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
