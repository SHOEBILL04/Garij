@using Microsoft.AspNetCore.Identity
@using Garij.Application.Interfaces
@using System.Security.Claims
@inject SignInManager<IdentityUser> SignInManager
@inject IProjectPurchaseService PurchaseService
@{
    var isUserSignedIn = SignInManager.IsSignedIn(User);
    var isAdmin = isUserSignedIn && User.IsInRole("Admin");
    var hasActiveLicense = false;
    var garageName = "GARIJ";
    if (isUserSignedIn)
    {
        var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
        var email = User.FindFirstValue(ClaimTypes.Email) ?? User.Identity?.Name;
        hasActiveLicense = isAdmin || (await PurchaseService.HasActiveLicenseAsync(userId, email));
        if (hasActiveLicense)
        {
            garageName = await PurchaseService.GetWorkshopNameAsync(userId, email);
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Garij Intelligent Vehicle Workshop</title>
    <meta name="description" content="Garij - Creative & Professional Mechanic Services, Vehicle Renovation, Tuning, and Intelligent Fleet & Service Management." />
    
    <!-- Google Fonts: Montserrat (Loaded with all weights and display=swap) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    
    <!-- Bootstrap CSS & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Color Scheme & Instant Theme Initializer (Prevents FOUC) -->
    <meta name="color-scheme" content="dark light" />
    <script>
        (function () {
            var theme = localStorage.getItem('garij_theme') || 'dark';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>

    <!-- Landing Custom Stylesheet -->
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Lottie Web Animation Engine -->
    <script src="~/lib/lottie/lottie.min.js" asp-append-version="true"></script>
</head>
<body class="landing-page-body">

    <!-- 1. Lottie Preloader Loading Animation -->
    <div id="page-preloader">
        <div class="preloader-lottie-container">
            <div id="lottie-preloader" class="preloader-lottie-player"></div>
        </div>
    </div>

    <!-- 2. Sticky Main Navigation Bar -->
    <nav class="navbar navbar-expand-lg main-navbar-sticky py-3">
        <div class="container-fluid px-lg-5 d-flex justify-content-between align-items-center">
            <a class="navbar-brand text-decoration-none py-0" asp-controller="Home" asp-action="Index">
                <div class="brand-emblem-wrap">
                    <svg class="brand-car-emblem" viewBox="0 0 100 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M 5 20 C 15 20, 24 18, 32 14 C 40 10, 47 4, 62 4 C 76 4, 83 9, 89 15 C 93 18, 96 20, 98 20" stroke="#00d2ff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M 35 13 C 42 8, 50 6, 61 6 C 71 6, 78 9, 83 14" stroke="#ffffff" stroke-width="1.4" stroke-linecap="round" stroke-opacity="0.75"/>
                    </svg>
                    <div class="d-flex flex-column text-start">
                        <div class="brand-title-text font-ethnocentric text-uppercase" style="letter-spacing: 0.5px; font-size: 1.15rem;">@(string.IsNullOrWhiteSpace(garageName) ? "GARIJ" : garageName)</div>
                        @if (isUserSignedIn && hasActiveLicense)
                        {
                            <span class="font-monospace text-info text-start" style="font-size: 0.62rem; letter-spacing: 1px; margin-top: -3px;">POWERED BY GARIJ</span>
                        }
                    </div>
                </div>
            </a>

            <!-- Mobile Navbar Toggler (Clean, no sidebar) -->
            <button class="navbar-toggler border-0 text-light d-lg-none p-2" type="button" data-bs-toggle="collapse" data-bs-target="#landingNavbarNav" aria-controls="landingNavbarNav" aria-expanded="false" aria-label="Toggle navigation menu">
                <i class="bi bi-list fs-2 text-info"></i>
            </button>

            <!-- Navigation Links (Centered, collapsible on mobile) -->
            <div class="collapse navbar-collapse justify-content-center" id="landingNavbarNav">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-2 gap-lg-4 text-center py-2 py-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">HOME</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="About">ABOUT</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Services">SERVICES</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Testimonials">TESTIMONIALS</a>
                    </li>
                    @if (!hasActiveLicense)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Pricing">PRICING</a>
                        </li>
                    }
                </ul>
            </div>

            <!-- Right Actions: Buy Project + Status Pill + Profile & Theme Switch -->
            <div class="landing-nav-actions d-flex align-items-center gap-2 gap-sm-3">
                @if (!hasActiveLicense)
                {
                    <!-- Buy Project Lifetime Button -->
                    <a asp-controller="Purchase" asp-action="Index" class="btn-nav-glow-buy landing-nav-buy" style="background: linear-gradient(135deg, #06b6d4, #0284c7); color: #050b14; font-weight: 700; border-radius: 50px; padding: 7px 18px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 0 15px rgba(6, 182, 212, 0.4); font-size: 0.85rem;" title="Buy Garij project">
                        <i class="bi bi-cart-check-fill"></i>
                        <span>BUY PROJECT</span>
                    </a>
                }
                else
                {
                    <a asp-controller="Purchase" asp-action="Status" class="btn btn-sm btn-outline-info rounded-pill px-3 py-1 font-monospace d-none d-md-inline-flex align-items-center gap-1" title="View Lifetime License Certificate">
                        <i class="bi bi-shield-check text-info"></i>
                        <span class="small fw-bold">LICENSED</span>
                    </a>
                }

                <!-- Status Lookup Quick Button -->
                <a href="/#status-tracker" class="btn-nav-status-pill d-none d-lg-inline-flex" title="Track your vehicle service progress">
                    <i class="bi bi-radar text-info"></i>
                    <span>Status Lookup</span>
                </a>

                @if (isUserSignedIn)
                {
                    var isMechanic = User.IsInRole("Mechanic");
                    var isFrontDesk = User.IsInRole("FrontDesk");

                    if (hasActiveLicense)
                    {
                        if (isAdmin || isFrontDesk)
                        {
                            <a asp-controller="Dashboard" asp-action="Index" class="btn-nav-glow-login d-inline-flex">
                                <i class="bi bi-speedometer2 me-1"></i>
                                <span>Dashboard</span>
                            </a>
                        }
                        else if (isMechanic)
                        {
                            <a asp-controller="Mechanic" asp-action="JobBoard" class="btn-nav-glow-login d-inline-flex">
                                <i class="bi bi-wrench me-1"></i>
                                <span>Job Board</span>
                            </a>
                        }
                    }
                    else
                    {
                        <!-- Unlicensed user: explicitly show Dashboard Locked button leading to Purchase -->
                        <a asp-controller="Purchase" asp-action="Index" class="btn btn-sm btn-outline-warning rounded-pill px-3 py-2 fw-bold d-inline-flex align-items-center gap-2 text-warning" title="Dashboard is locked until a lifetime license is purchased">
                            <i class="bi bi-lock-fill"></i>
                            <span>Dashboard (Locked)</span>
                        </a>
                    }

                    <!-- User Profile Badge -->
                    <div class="d-none d-md-inline-flex align-items-center gap-1 px-2 py-1 rounded-pill" style="background: rgba(255, 255, 255, 0.05); border: 1px solid var(--border-dark);" title="Logged in as @User.Identity?.Name">
                        <i class="bi bi-person-circle text-info fs-6"></i>
                        <span class="text-light small fw-semibold">@User.Identity?.Name</span>
                    </div>

                    <!-- Theme Switcher Option at Side of Profile -->
                    <button type="button" class="theme-toggle-btn" data-theme-toggle title="Toggle Light / Dark Mode" aria-label="Toggle Light and Dark Mode">
                        <i class="bi bi-sun-fill theme-toggle-icon text-warning"></i>
                        <span class="theme-toggle-text d-none d-md-inline">Light</span>
                    </button>

                    <a asp-controller="Account" asp-action="Logout" class="btn-nav-glow-register d-none d-sm-inline-flex" title="Sign out">
                        <i class="bi bi-box-arrow-right me-1"></i>
                        <span>Sign Out</span>
                    </a>
                }
                else
                {
                    <!-- Theme Switcher Option at Side of Profile / Login -->
                    <button type="button" class="theme-toggle-btn" data-theme-toggle title="Toggle Light / Dark Mode" aria-label="Toggle Light and Dark Mode">
                        <i class="bi bi-sun-fill theme-toggle-icon text-warning"></i>
                        <span class="theme-toggle-text d-none d-md-inline">Light</span>
                    </button>

                    <a asp-controller="Account" asp-action="Login" class="btn-nav-glow-login d-inline-flex">
                        <i class="bi bi-box-arrow-in-right me-1"></i>
                        <span>Login</span>
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn-nav-glow-register d-none d-sm-inline-flex" title="Create account" aria-label="Create account">
                        <i class="bi bi-person-plus me-1"></i>
                        <span>Create Account</span>
                    </a>
                }
            </div>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- 3. Automotive Luxury Dark Footer -->
    <footer class="automotive-footer">
        <div class="container px-lg-5">
            <div class="row g-4">
                <!-- Col 1: Brand & Bio -->
                <div class="col-lg-4 col-md-6">
                    <a class="text-decoration-none d-inline-block mb-3" asp-controller="Home" asp-action="Index">
                        <div class="brand-emblem-wrap align-items-start">
                            <svg class="brand-car-emblem" viewBox="0 0 100 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M 5 20 C 15 20, 24 18, 32 14 C 40 10, 47 4, 62 4 C 76 4, 83 9, 89 15 C 93 18, 96 20, 98 20" stroke="#00d2ff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M 35 13 C 42 8, 50 6, 61 6 C 71 6, 78 9, 83 14" stroke="#ffffff" stroke-width="1.4" stroke-linecap="round" stroke-opacity="0.75"/>
                            </svg>
                            <div class="brand-title-text font-ethnocentric">GARIJ</div>
                        </div>
                    </a>
                    <p class="small text-secondary mb-3">
                        Garij is an intelligent, full-spectrum vehicle service center management platform providing precision diagnostic tuning, multi-point restoration, and real-time transparent tracking.
                    </p>
                    <div class="d-flex gap-3 text-info fs-5">
                        <a href="#" class="text-info"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-info"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-info"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="text-info"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>

                <!-- Col 2: Quick Links -->
                <div class="col-lg-2 col-md-6">
                    <h5 class="footer-heading">NAVIGATION</h5>
                    <ul class="footer-links-list">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Home" asp-action="About">About Workshop</a></li>
                        <li><a asp-controller="Home" asp-action="Services">Our Services</a></li>
                        <li><a asp-controller="Home" asp-action="Testimonials">Testimonials</a></li>
                        @if (!hasActiveLicense)
                        {
                            <li><a asp-controller="Home" asp-action="Pricing">Pricing &amp; License</a></li>
                        }
                        else
                        {
                            <li><a asp-controller="Purchase" asp-action="Status">License Certificate</a></li>
                        }
                        <li><a href="/#status-tracker">Track Service Status</a></li>
                    </ul>
                </div>

                <!-- Col 3: Workshop Services -->
                <div class="col-lg-3 col-md-6">
                    <h5 class="footer-heading">SERVICES</h5>
                    <ul class="footer-links-list">
                        <li><a asp-controller="Home" asp-action="Services">Complete Engine Overhaul</a></li>
                        <li><a asp-controller="Home" asp-action="Services">Performance ECU Tuning</a></li>
                        <li><a asp-controller="Home" asp-action="Services">Brembo &amp; Disc Brakes</a></li>
                        <li><a asp-controller="Home" asp-action="Services">Transmission Fluid &amp; Parts</a></li>
                        <li><a asp-controller="Home" asp-action="Services">Neon &amp; Custom Lighting</a></li>
                    </ul>
                </div>

                <!-- Col 4: Contact & Working Hours -->
                <div class="col-lg-3 col-md-6">
                    <h5 class="footer-heading">HOURS &amp; LOCATION</h5>
                    <p class="small mb-1 text-light"><i class="bi bi-geo-alt text-info me-2"></i>141 &amp; 142, Love Road, Tejgaon Industrial Area, Dhaka-1208</p>
                    <p class="small mb-1 text-light"><i class="bi bi-telephone text-info me-2"></i><a href="tel:+8801711234567" class="text-light text-decoration-none">+880 1711-234567</a></p>
                    <p class="small mb-3 text-light"><i class="bi bi-envelope text-info me-2"></i><a href="mailto:garij@gmail.com" class="text-light text-decoration-none">garij@gmail.com</a></p>
                    <div class="p-2 rounded-3 bg-dark border border-secondary border-opacity-25 small">
                        <span class="text-info fw-bold d-block">WORKSHOP HOURS:</span>
                        <span>Sat - Thu: 08:00 AM - 08:00 PM</span><br/>
                        <span class="text-muted">Friday: Emergency On-Call</span>
                    </div>
                </div>
            </div>

            <!-- Bottom Copyright Bar -->
            <div class="footer-bottom-bar d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    &copy; 2026 <strong>GARIJ</strong> - All Rights Reserved. Creative &amp; Professional Automotive Engineering.
                </div>
                <div class="d-flex gap-3">
                    <a href="/#status-tracker" class="text-secondary text-decoration-none small">Status Lookup</a>
                    <a asp-controller="Account" asp-action="Login" class="text-secondary text-decoration-none small">Staff Portal</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme-toggle.js" asp-append-version="true"></script>
    <script src="~/js/landing.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
