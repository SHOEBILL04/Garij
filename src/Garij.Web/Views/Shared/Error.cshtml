@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;

    var accent = Model.StatusCode >= 500 ? "#f87171" : (Model.StatusCode == 404 ? "#38bdf8" : "#fbbf24");
    var icon = Model.StatusCode switch
    {
        404 => "bi-compass",
        400 => "bi-exclamation-triangle",
        401 => "bi-box-arrow-in-right",
        403 => "bi-shield-lock",
        _ => "bi-bug"
    };
}

<div class="app-page-header">
    <div>
        <h1 class="app-page-title" style="color:@accent;">
            <i class="bi @icon me-2"></i>@Model.Title
        </h1>
        <p class="app-page-subtitle">HTTP @Model.StatusCode</p>
    </div>
    <a asp-controller="Home" asp-action="Index" class="app-btn app-btn-outline">Back to Home</a>
</div>

<div class="app-card" style="max-width: 720px;">
    <p class="text-white" id="error-message">@Model.Message</p>

    @if (Model.ShowRequestedPath)
    {
        <p class="app-page-subtitle mb-0">
            <strong class="text-white">Requested address:</strong> <code>@Model.RequestedPath</code>
        </p>
    }

    @if (Model.ShowRequestId)
    {
        <p class="app-page-subtitle mb-0">
            <strong class="text-white">Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <div class="d-flex gap-2 mt-4">
        <a asp-controller="Dashboard" asp-action="Index" class="app-btn app-btn-primary">Go to Dashboard</a>
        <a href="javascript:history.back()" class="app-btn app-btn-outline">Go Back</a>
    </div>
</div>
